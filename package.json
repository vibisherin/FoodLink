{
  "name": "foodlink",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "install:all": "npm install && npm --prefix backend install",
    "db:setup": "npm --prefix backend run db:setup",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset",
    "server": "npm --prefix backend run dev",
    "dev:all": "concurrently -n api,web -c green,cyan \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "vite": "^5.4.0"
  }
}
